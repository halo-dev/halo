  "lint-staged": {
    "**/*": "vp fmt --no-error-on-unmatched-pattern",
    "*.{ts,mts,tsx,vue}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ]
  },
  "browserslist": [
    "defaults"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.17.0"
}
